output "folder_ids" {
  description = "Map of created top-level folder names to Resource Manager folder IDs"
  value       = { for k, v in module.top_level_folders : k => v.id }
}

output "org_sink_writer_identity" {
  description = "The Service Account generated by Google Cloud for the organization log sink"
  value       = google_logging_organization_sink.org_admin_audit_sink.writer_identity
}
